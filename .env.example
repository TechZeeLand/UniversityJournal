APP_ENV=production
APP_DEBUG=false
APP_URL=https://journal.example.edu
APP_TIMEZONE=Asia/Dhaka
APP_KEY=change-me-to-a-long-random-string
HTTP_PORT=8090
DB_NAME=university_journal
DB_USER=journal
DB_PASSWORD=change-me-no-quotes-or-backslashes
# First-boot tech admin (created only if no tech admin exists; must change password at first login)
INITIAL_ADMIN_UID=tech-admin
INITIAL_ADMIN_PASSWORD=change-me-too
# Upstream services mirrored and cached by this site's own nginx
ICONS_HOST=icons.rayaz.org
FONTS_HOST=fonts.rayaz.org
# Reverse proxies whose X-Forwarded-For header is believed (comma-separated IPs/CIDRs). Empty = private networks only.
# Needed so login lockout sees each visitor's real IP, not the proxy's.
TRUSTED_PROXIES=
# Host folder that holds ALL site data (database, uploads, backups). Default: ./data next to docker-compose.yml.
# On Portainer use an absolute path that exists on the host, e.g. /srv/university-journal/data
DATA_DIR=./data
# Backups: automatic database dumps are configured in Tech portal > Settings > Backups.
