user nginx;
worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
  include /etc/nginx/mime.types;
  default_type application/octet-stream;
  access_log off;
  sendfile on;
  server_tokens off;
  client_max_body_size 30m;
  gzip on;
  resolver __RESOLVER__ valid=300s ipv6=off;
  resolver_timeout 5s;
  proxy_cache_path /var/www/storage/proxy-cache levels=1:2 keys_zone=tzl:10m max_size=500m inactive=60d use_temp_path=off;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  server {
    listen 80 default_server;
    server_name _;
    root /var/www/app/public;
    index index.php;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Never serve hidden files
    location ~ /\. { deny all; }

    # Public uploads (images etc). No PHP is ever executed here.
    location /uploads/ {
      alias /var/www/storage/uploads/public/;
      expires 7d;
      add_header X-Content-Type-Options nosniff always;
      location ~ \.php$ { return 403; }
    }


    # Cached mirrors of the TechZeeLand fonts and icons services. Visitors only ever talk to this site.
    location /tzl-fonts/ {
      set $fonts_up https://__FONTS_HOST__;
      rewrite ^/tzl-fonts/(.*)$ /$1 break;
      proxy_pass $fonts_up;
      proxy_ssl_server_name on;
      proxy_set_header Host __FONTS_HOST__;
      proxy_set_header Accept-Encoding "";
      proxy_cache tzl;
      proxy_cache_valid 200 7d;
      proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
      proxy_cache_background_update on;
      proxy_cache_lock on;
      sub_filter 'https://__FONTS_HOST__/' '/tzl-fonts/';
      sub_filter_once off;
      sub_filter_types text/css;
      add_header X-Cache-Status $upstream_cache_status;
      add_header X-Content-Type-Options nosniff always;
    }

    location /icons-cdn/ {
      set $icons_up https://__ICONS_HOST__;
      rewrite ^/icons-cdn/(.*)$ /$1 break;
      proxy_pass $icons_up;
      proxy_ssl_server_name on;
      proxy_set_header Host __ICONS_HOST__;
      proxy_set_header Accept-Encoding "";
      proxy_cache tzl;
      proxy_cache_valid 200 1d;
      proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
      proxy_cache_background_update on;
      proxy_cache_lock on;
      sub_filter 'https://__ICONS_HOST__/' '/icons-cdn/';
      sub_filter_once off;
      sub_filter_types text/css application/javascript;
      add_header X-Cache-Status $upstream_cache_status;
      add_header X-Content-Type-Options nosniff always;
    }

    location /assets/ { expires 7d; try_files $uri =404; }

    location / { try_files $uri /index.php?$query_string; }

    location = /index.php {
      include fastcgi_params;
      fastcgi_param SCRIPT_FILENAME $document_root/index.php;
      fastcgi_param HTTPS $http_x_forwarded_proto_https;
      fastcgi_pass unix:/run/php-fpm.sock;
      fastcgi_read_timeout 60s;
    }

    # Any other .php file is blocked
    location ~ \.php$ { return 404; }
  }

  map $http_x_forwarded_proto $http_x_forwarded_proto_https {
    default "";
    https   "on";
  }
}
